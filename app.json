{
  "expo": {
    "name": "G-Lock",
    "slug": "g-lock-homeguard",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldsmith.glock",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "G-Lock needs camera access to enroll faces for biometric security",
        "NSFaceIDUsageDescription": "G-Lock uses Face ID for secure access control"
      },
      "buildNumber": "1",
      "appleId": "shanegoldsmith@icloud.com",
      "teamId": "8X94P5WL5G"
    },
    "android": {
      "package": "com.goldsmith.glock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0e17"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "c07b1939-9c54-4d4f-ad3b-6aa787629e7e"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}